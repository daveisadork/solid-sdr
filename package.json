{
  "name": "solid-sdr",
  "private": true,
  "author": "Dave Hayes <dwhayes@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev:server",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @repo/flexlib test:integration",
    "typecheck": "turbo run typecheck",
    "release:build": "goreleaser build --snapshot --clean && rm -rf apps/server/internal/static/web",
    "release": "goreleaser release --clean && rm -rf apps/server/internal/static/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  }
}
