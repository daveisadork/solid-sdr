{
  "name": "SolidSDR",
  "short_name": "SolidSDR",
  "description": "Web client for FlexRadio SmartSDR radios.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#011d2d",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any"
    },
    {
      "src": "/icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/icon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ]
}
